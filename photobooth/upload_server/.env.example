# Serveur web des photos : copiez ce fichier en .env puis adaptez les valeurs.

# Token partagé avec la borne (même valeur que UPLOAD_API_TOKEN dans le .env du photobooth).
# Générez-en un avec : flask --app app generate-token
UPLOAD_API_TOKEN=

# Nom affiché en haut des pages
SITE_NAME=Photobooth

# Adresse publique du site (utilisée pour les liens absolus et l'aperçu des liens partagés)
PUBLIC_BASE_URL=https://photos.example.com

# Suppression automatique des photos (en jours après leur mise en ligne ; 0 = jamais)
PHOTO_RETENTION_DAYS=30

# Taille maximale d'une photo envoyée (Mo)
MAX_UPLOAD_MB=15

# Dossiers (chemins relatifs au dossier upload_server)
UPLOAD_DIR=uploads
DATABASE_PATH=data/photos.db

# Adresse affichée pour les demandes de suppression (RGPD), facultative
CONTACT_EMAIL=

# true si le site est derrière un reverse proxy (nginx, Caddy…) : vraie adresse IP des visiteurs
BEHIND_PROXY=false

# Protection contre la recherche de codes au hasard : N codes incorrects maximum par IP et par fenêtre
LOOKUP_LIMIT=30
LOOKUP_WINDOW_SECONDS=600
