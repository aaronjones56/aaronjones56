# =============================================================================
#  Configuration du photobooth : copiez ce fichier en .env puis adaptez-le.
#  Les valeurs ci-dessous permettent de tout tester SANS matériel ni Internet.
# =============================================================================

# Clé de session Flask (laisser vide : une clé aléatoire est créée dans data/.secret_key)
FLASK_SECRET_KEY=

# Code PIN de l'administration (4 à 12 chiffres) : CHANGEZ-LE avant un événement
ADMIN_PIN=1234

# --- Appareil photo -----------------------------------------------------------
# mock     = photo de test (static/assets/test_photo.jpg), aucun matériel
# webcam   = webcam USB (OpenCV)
# external = vrai appareil photo piloté par une commande Windows (voir README)
CAMERA_MODE=mock

# Numéro de la webcam (0 = première webcam) et résolution demandée
CAMERA_DEVICE=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
# auto (DirectShow sous Windows), dshow, msmf, v4l2 ou any
CAMERA_BACKEND=auto

# Commande de déclenchement (mode external). Variables : {output} {output_dir} {filename} {stem}
# Si la commande commence par un chemin entre guillemets, entourez TOUTE la valeur d'apostrophes :
# CAMERA_CAPTURE_COMMAND='"C:\Program Files (x86)\digiCamControl\CameraControlCmd.exe" /filename "{output}" /capture'
CAMERA_CAPTURE_COMMAND=
CAMERA_CAPTURE_TIMEOUT=30
# Dossier où le logiciel de l'appareil dépose ses photos, s'il ne sait pas utiliser {output}
CAMERA_WATCH_DIR=
# Adresse d'une image d'aperçu en direct (ex. digiCamControl : http://127.0.0.1:5513/liveview.jpg)
CAMERA_PREVIEW_URL=

# Photo utilisée par le mode mock (générée automatiquement si absente)
TEST_PHOTO=static/assets/test_photo.jpg
# Aperçu en miroir (comme un miroir : plus naturel pour les invités). La photo finale n'est jamais inversée.
PREVIEW_MIRROR=true
# Point de cadrage (0.5 = centre). CROP_FOCUS_Y=0.4 garde un peu plus le haut de l'image.
CROP_FOCUS_X=0.5
CROP_FOCUS_Y=0.5

# --- Imprimante ------------------------------------------------------------------
# null = simulation (rien n'est imprimé), windows = imprimante Windows (Canon SELPHY CP1500…)
PRINTER_MODE=null
# Nom exact de l'imprimante Windows (vide = imprimante par défaut). Modifiable dans /admin.
PRINTER_NAME=
# Afficher le bouton IMPRIMER sur la borne
PRINT_ENABLED=true
# Imprimer automatiquement après chaque photo (sans validation du client)
AUTO_PRINT=false
# fill = bord à bord (léger rognage possible), fit = image entière (marges possibles)
PRINT_FIT_MODE=fill
# Nombre maximum de copies par impression, et d'impressions par photo (0 = illimité)
PRINT_MAX_COPIES=2
PRINT_LIMIT_PER_PHOTO=0
# Durée simulée d'une impression en mode null (secondes)
PRINTER_SIMULATED_DELAY=1.5

# --- Événement ----------------------------------------------------------------------
# Créé au premier démarrage s'il n'existe aucun événement actif ; ensuite, gérez-les dans /admin.
EVENT_NAME=Photobooth Test
EVENT_SLUG=photobooth-test
# AAAA-MM-JJ (vide = date du jour)
EVENT_DATE=

# --- Partage des photos -----------------------------------------------------------
# Adresse du site des photos : chaque QR code pointe vers PUBLIC_PHOTO_URL/p/CODE
PUBLIC_PHOTO_URL=https://photos.example.com

# Upload après l'événement (bouton dans /admin ou scripts\upload_pending.bat)
UPLOAD_ENABLED=false
UPLOAD_API_URL=https://photos.example.com/api/upload
UPLOAD_API_TOKEN=
UPLOAD_TIMEOUT=60

# Durée de conservation en ligne annoncée aux invités (la suppression est faite par le serveur)
PHOTO_RETENTION_DAYS=30

# --- Interface ------------------------------------------------------------------------
# Retour automatique à l'accueil après X secondes sans interaction
SESSION_TIMEOUT=45
COUNTDOWN_SECONDS=3
KIOSK_TITLE=PHOTOBOOTH
ACCENT_COLOR=#ff3d7f
SOUND_ENABLED=true

# --- Photo finale ---------------------------------------------------------------------
# 1200 x 1800 = 10 x 15 cm portrait à 300 dpi
OUTPUT_WIDTH=1200
OUTPUT_HEIGHT=1800
JPEG_QUALITY=95
# Ajouter le QR code et le code sur le tirage imprimé (la photo en ligne reste sans QR code)
QR_ON_PRINT=false
QR_PRINT_SIZE=240
# bottom-right, bottom-left, top-right, top-left (si le cadre ne précise pas d'emplacement)
QR_PRINT_POSITION=bottom-right

# --- Serveur local et dossiers ---------------------------------------------------------
HOST=127.0.0.1
PORT=5000
DATA_DIR=data
FRAMES_DIR=static/frames
LOG_DIR=logs
DATABASE_PATH=database/photobooth.db
# debug, info, warning ou error
LOG_LEVEL=info
